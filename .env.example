# Copy this file to .env and fill in the values from Google Cloud Console.
# .env is ignored by git, so the secret is never committed.
# See "Sign in with Google" in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails of accounts that are always admins, for example:
# COURSESWEEP_ADMIN_EMAILS=you@gmail.com,teammate@gmail.com
COURSESWEEP_ADMIN_EMAILS=
